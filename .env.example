# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host/chipviagem?sslmode=require

# Site (produção). Em desenvolvimento local use http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://chipviagem.com.br

# Session (admin auth) — gere uma string aleatória longa
SESSION_SECRET=change-me-to-a-random-64-char-string

# eSIM Provider (mock | esimaccess | bappy)
ESIM_PROVIDER=mock

# Asaas Payments
ASAAS_API_KEY=sua_chave_sandbox_asaas
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=token_para_validar_webhooks

# E-mail (Resend)
RESEND_API_KEY=re_sua_chave

# Admin seed (scripts/seed-admin.ts)
ADMIN_EMAIL=admin@chipviagem.com.br
ADMIN_PASSWORD=senha_segura_aqui

# Seed defaults
USD_BRL_RATE=5.50
DEFAULT_MARGIN_PERCENT=40

# Vercel Cron (proteção das rotas /api/cron/*)
CRON_SECRET=gere-uma-string-aleatoria-longa

# Assistente IA (DeepSeek) — https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://chipviagem.com.br
NEXT_PUBLIC_APP_URL=https://chipviagem.com.br

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
